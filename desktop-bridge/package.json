{
  "name": "foundr1-desktop-bridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "node src/main.mjs check",
    "login": "node src/main.mjs login",
    "check:demae": "node src/main.mjs check demae_can",
    "credentials:demae": "node macos/store-demae-credentials.mjs",
    "menu:audit:demae": "node scripts/normalize-demae-menu.mjs",
