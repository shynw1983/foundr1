    "voice": "node src/voice-command.mjs",
    "install:mac": "node macos/install-launch-agent.mjs",
    "uninstall:mac": "node macos/uninstall-launch-agent.mjs",
    "start": "node src/main.mjs run",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "puppeteer-core": "^25.1.0",
    "ws": "^8.18.3"
  }
}
