<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="6dp" android:background="@drawable/inventory_widget_background">
    <TextView android:id="@+id/inventory_widget_title"
        android:layout_width="match_parent" android:layout_height="16dp"
        android:text="Foundr1 Store" android:textColor="#526A5F" android:textSize="10sp"
        android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <Button android:id="@+id/inventory_widget_shortage"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginEnd="3dp" android:background="@drawable/inventory_widget_button"
            android:minWidth="0dp" android:minHeight="0dp" android:padding="2dp" android:gravity="center"
            android:text="@string/inventory_widget_shortage_short" android:textColor="#183B2E"
            android:textSize="12sp" android:textAllCaps="false" android:maxLines="1" />
        <Button android:id="@+id/inventory_widget_restore"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="3dp" android:background="@drawable/inventory_widget_primary"
            android:minWidth="0dp" android:minHeight="0dp" android:padding="2dp" android:gravity="center"
            android:text="@string/inventory_widget_restore_short" android:textColor="#FFFFFF"
            android:textSize="12sp" android:textAllCaps="false" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
