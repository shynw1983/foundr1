<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/inventory_widget_background"
    android:paddingHorizontal="8dp" android:paddingVertical="2dp" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:gravity="center_vertical">
        <TextView android:id="@+id/inventory_widget_title"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="Foundr1 Store" android:textColor="#183B2E" android:textSize="12sp"
            android:fontFamily="sans-serif-medium" android:gravity="center_vertical"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/inventory_widget_refresh"
            android:layout_width="wrap_content" android:layout_height="match_parent"
            android:minWidth="60dp" android:gravity="center_vertical|end"
            android:paddingStart="6dp" android:text="@string/inventory_widget_refresh"
            android:textColor="#526A5F" android:textSize="10sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical">
        <TextView android:id="@+id/inventory_widget_status"
            android:layout_width="wrap_content" android:layout_height="match_parent"
            android:gravity="center_vertical" android:paddingEnd="8dp"
            android:text="@string/inventory_widget_empty" android:textColor="#183B2E" android:textSize="12sp"
            android:maxLines="1" />
        <LinearLayout android:id="@+id/inventory_widget_items"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center_vertical" android:orientation="horizontal" />
    </LinearLayout>
    <LinearLayout android:id="@+id/inventory_widget_more"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" />
    <LinearLayout android:id="@+id/inventory_widget_sync"
        android:layout_width="match_parent" android:layout_height="30dp" android:orientation="vertical">
        <TextView android:id="@+id/inventory_widget_operation"
            android:layout_width="match_parent" android:layout_height="16dp"
            android:maxLines="1" android:ellipsize="end" android:text="@string/inventory_widget_no_operation"
            android:textColor="#526A5F" android:textSize="11sp" android:includeFontPadding="false" />
        <TextView android:id="@+id/inventory_widget_platforms"
            android:layout_width="match_parent" android:layout_height="14dp"
            android:maxLines="1" android:ellipsize="end" android:text="@string/inventory_widget_sync_help"
            android:textColor="#526A5F" android:textSize="11sp" android:includeFontPadding="false" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp"
        android:layout_marginTop="2dp" android:orientation="horizontal">
        <Button android:id="@+id/inventory_widget_shortage"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginEnd="4dp" android:background="@drawable/inventory_widget_button"
            android:gravity="center" android:minHeight="0dp" android:minWidth="0dp" android:padding="4dp"
            android:text="@string/inventory_widget_shortage" android:textAllCaps="false"
            android:textColor="#183B2E" android:textSize="12sp" android:fontFamily="sans-serif-medium"
            android:maxLines="1" android:ellipsize="end" />
        <Button android:id="@+id/inventory_widget_restore"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="4dp" android:background="@drawable/inventory_widget_primary"
            android:gravity="center" android:minHeight="0dp" android:minWidth="0dp" android:padding="4dp"
            android:text="@string/inventory_widget_restore" android:textAllCaps="false"
            android:textColor="#FFFFFF" android:textSize="12sp" android:fontFamily="sans-serif-medium"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
