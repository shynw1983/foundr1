<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/inventory_widget_background"
    android:paddingHorizontal="14dp" android:paddingVertical="10dp" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center_vertical">
        <TextView android:id="@+id/inventory_widget_title" style="@style/InventoryWidgetText"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="Foundr1 Store" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/inventory_widget_refresh" style="@style/InventoryWidgetText"
            android:layout_width="wrap_content" android:layout_height="match_parent"
            android:gravity="center_vertical|end" android:paddingStart="10dp"
            android:text="@string/inventory_widget_refresh" android:textColor="@color/widget_muted" android:textSize="10sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="6dp" android:layout_marginBottom="4dp" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/inventory_widget_metric"
            android:layout_width="64dp" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center_vertical">
            <TextView android:id="@+id/inventory_widget_count" style="@style/InventoryWidgetText"
                android:layout_width="match_parent" android:layout_height="34dp"
                android:text="—" android:textSize="32sp" android:fontFamily="sans-serif-light"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="32sp" />
            <TextView android:id="@+id/inventory_widget_status" style="@style/InventoryWidgetText"
                android:layout_width="match_parent" android:layout_height="16dp"
                android:text="@string/inventory_widget_shortage_short" android:textSize="10sp" android:textColor="@color/widget_muted" />
        </LinearLayout>
        <LinearLayout android:id="@+id/inventory_widget_items"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_vertical" />
    </LinearLayout>
    <LinearLayout android:id="@+id/inventory_widget_sync"
        android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center_vertical">
        <TextView android:id="@+id/inventory_widget_platforms" style="@style/InventoryWidgetText"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="@string/inventory_widget_sync_help" android:textSize="10sp" android:textColor="@color/widget_muted" />
        <TextView android:id="@+id/inventory_widget_operation" style="@style/InventoryWidgetText"
            android:layout_width="wrap_content" android:layout_height="match_parent"
            android:maxWidth="100dp" android:paddingStart="8dp" android:textSize="10sp"
            android:textColor="@color/widget_muted" android:gravity="center_vertical|end" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="6dp">
        <Button android:id="@+id/inventory_widget_shortage" style="@style/InventoryWidgetButton"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginEnd="4dp" android:background="@drawable/inventory_widget_secondary"
            android:text="@string/inventory_widget_shortage" />
        <Button android:id="@+id/inventory_widget_restore" style="@style/InventoryWidgetButton"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="4dp" android:background="@drawable/inventory_widget_primary"
            android:text="@string/inventory_widget_restore" android:textColor="@color/widget_surface" />
    </LinearLayout>
</LinearLayout>
