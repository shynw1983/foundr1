<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/inventory_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/inventory_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Foundr1 Store"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/inventory_widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="在庫状態を確認中…"
            android:textColor="#D6E6DF"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/inventory_widget_shortage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/inventory_widget_button"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="4dp"
            android:text="欠品登録"
            android:textColor="#A12828"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/inventory_widget_restore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/inventory_widget_button"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="4dp"
            android:text="入荷・販売再開"
            android:textColor="#134E3A"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
