<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:paddingHorizontal="12dp" android:paddingTop="8dp" android:paddingBottom="12dp" android:background="@drawable/inventory_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:gravity="center_vertical">
        <TextView android:id="@+id/inventory_widget_title" style="@style/InventoryWidgetText" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Foundr1 Store" android:textColor="@color/widget_muted" android:textSize="12sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="12sp" />
        <LinearLayout android:id="@+id/inventory_widget_metric" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="6dp" android:gravity="center_vertical">
            <TextView android:id="@+id/inventory_widget_status" style="@style/InventoryWidgetText" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="欠品" android:textSize="10sp" />
            <TextView android:id="@+id/inventory_widget_count" style="@style/InventoryWidgetText" android:layout_width="wrap_content" android:layout_height="match_parent" android:paddingStart="4dp" android:text="—" android:textSize="13sp" />
        </LinearLayout>
        <TextView android:id="@+id/inventory_widget_refresh" style="@style/InventoryWidgetText" android:layout_width="24dp" android:layout_height="match_parent" android:gravity="center" android:layout_marginStart="3dp" android:text="↻" android:textSize="14sp" android:textColor="@color/widget_muted" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:layout_marginTop="4dp" android:layout_marginBottom="4dp">
        <LinearLayout android:id="@+id/inventory_widget_left" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center_vertical" android:paddingHorizontal="7dp" android:background="@drawable/inventory_widget_control">
            <TextView android:id="@+id/inventory_widget_left_title" style="@style/InventoryWidgetText" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.15" android:textSize="11sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp" />
            <TextView android:id="@+id/inventory_widget_left_value" style="@style/InventoryWidgetText" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical|end" android:textSize="11sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp" />
            <ImageView android:id="@+id/inventory_widget_left_indicator" android:layout_width="18dp" android:layout_height="12dp" android:layout_marginStart="3dp" android:src="@drawable/inventory_widget_chevron" android:importantForAccessibility="no" />
            <TextView android:id="@+id/inventory_widget_left_detail" style="@style/InventoryWidgetText" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/inventory_widget_right" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="4dp" android:gravity="center_vertical" android:paddingHorizontal="7dp" android:background="@drawable/inventory_widget_control">
            <TextView android:id="@+id/inventory_widget_right_title" style="@style/InventoryWidgetText" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.15" android:textSize="11sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp" />
            <TextView android:id="@+id/inventory_widget_right_value" style="@style/InventoryWidgetText" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical|end" android:textSize="11sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp" />
            <ImageView android:id="@+id/inventory_widget_right_indicator" android:layout_width="18dp" android:layout_height="12dp" android:layout_marginStart="3dp" android:src="@drawable/inventory_widget_chevron" android:importantForAccessibility="no" />
            <TextView android:id="@+id/inventory_widget_right_detail" style="@style/InventoryWidgetText" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="6dp">
        <LinearLayout android:id="@+id/inventory_widget_device_left" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:orientation="vertical" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:paddingVertical="3dp" android:background="@drawable/inventory_widget_control">
            <LinearLayout android:layout_width="match_parent" android:layout_height="16dp" android:gravity="center_vertical">
                <TextView android:id="@+id/inventory_widget_device_left_title" style="@style/InventoryWidgetText" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="12sp" android:textColor="@color/widget_muted" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="12sp" />
                <ImageView android:id="@+id/inventory_widget_device_left_indicator" android:layout_width="24dp" android:layout_height="14dp" android:layout_marginStart="3dp" android:src="@drawable/inventory_widget_chevron" android:importantForAccessibility="no" />
            </LinearLayout>
            <TextView android:id="@+id/inventory_widget_device_left_value" style="@style/InventoryWidgetText" android:layout_width="match_parent" android:layout_height="18dp" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="15sp" />
            <TextView android:id="@+id/inventory_widget_device_left_detail" style="@style/InventoryWidgetText" android:layout_width="match_parent" android:layout_height="18dp" android:textSize="10sp" android:textColor="@color/widget_muted" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/inventory_widget_device_right" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="4dp" android:orientation="vertical" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:paddingVertical="3dp" android:background="@drawable/inventory_widget_control">
            <LinearLayout android:layout_width="match_parent" android:layout_height="16dp" android:gravity="center_vertical">
                <TextView android:id="@+id/inventory_widget_device_right_title" style="@style/InventoryWidgetText" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="12sp" android:textColor="@color/widget_muted" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="12sp" />
                <ImageView android:id="@+id/inventory_widget_device_right_indicator" android:layout_width="24dp" android:layout_height="14dp" android:layout_marginStart="3dp" android:src="@drawable/inventory_widget_chevron" android:importantForAccessibility="no" />
            </LinearLayout>
            <TextView android:id="@+id/inventory_widget_device_right_value" style="@style/InventoryWidgetText" android:layout_width="match_parent" android:layout_height="18dp" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="15sp" />
            <TextView android:id="@+id/inventory_widget_device_right_detail" style="@style/InventoryWidgetText" android:layout_width="match_parent" android:layout_height="18dp" android:textSize="10sp" android:textColor="@color/widget_muted" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/inventory_widget_sync" android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/inventory_widget_platforms" style="@style/InventoryWidgetText" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textColor="@color/widget_muted" android:textSize="10sp" />
        <TextView android:id="@+id/inventory_widget_operation" style="@style/InventoryWidgetText" android:layout_width="wrap_content" android:layout_height="match_parent" android:textColor="@color/widget_muted" android:textSize="10sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp">
        <Button android:id="@+id/inventory_widget_shortage" style="@style/InventoryWidgetButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/inventory_widget_secondary" android:text="@string/inventory_widget_shortage" android:textSize="12sp" />
        <Button android:id="@+id/inventory_widget_restore" style="@style/InventoryWidgetButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="4dp" android:background="@drawable/inventory_widget_primary" android:text="@string/inventory_widget_restore" android:textColor="@color/widget_surface" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
